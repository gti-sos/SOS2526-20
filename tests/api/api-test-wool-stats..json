    {
      "name": "Get data 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Devuelve un único elemento (objeto)\", function () {",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 1. Comprobamos que la respuesta es un objeto y no un array",
              "    pm.expect(jsonData).to.be.an('object');",
              "    pm.expect(Array.isArray(jsonData)).to.be.false;",
              "    ",
              "    // 2. Comprobamos que el elemento es exactamente el que hemos pedido",
              "    pm.expect(jsonData.period).to.eql(2014);",
              "    pm.expect(jsonData.reporterdesc).to.eql(\"España\");",
              "    pm.expect(jsonData.flowdesc).to.eql(\"Import\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }

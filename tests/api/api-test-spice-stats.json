    {
      "name": "get 200 /:area/:item/:year",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Validación genérica de área, item y año\", function () {\r",
              "    const res = pm.response.json();\r",
              "\r",
              "    // Obtener la ruta completa\r",
              "    const path = pm.request.url.path;\r",
              "\r",
              "    // Extraer parámetros según la estructura:\r",
              "    // /api/v1/spice-stats/{area}/{item}/{year}\r",
              "    const area = decodeURIComponent(path[path.length - 3]);\r",
              "    const item = decodeURIComponent(path[path.length - 2]);\r",
              "    const year = parseInt(path[path.length - 1], 10);\r",
              "\r",
              "    // Validaciones dinámicas\r",
              "    pm.expect(res).to.have.property(\"area\", area);\r",
              "    pm.expect(res).to.have.property(\"item\", item);\r",
              "    pm.expect(res).to.have.property(\"year\", year);\r",
              "\r",
              "    // Validación opcional: asegurar que existan campos clave\r",
              "    [\"domain_code\", \"area_code\", \"item_code\", \"unit\"].forEach(field => {\r",
              "        pm.expect(res).to.have.property(field);\r",
              "    });\r",
              "\r",
              "    // Validación opcional de valores numéricos si existen\r",
              "    [\"import\", \"export\", \"production\", \"consumption\"].forEach(field => {\r",
              "        if (res[field] !== undefined) {\r",
              "            pm.expect(res[field]).to.be.a(\"number\");\r",
              "        }\r",
              "    });\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],

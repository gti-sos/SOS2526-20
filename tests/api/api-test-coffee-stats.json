    {
      "name": "GET 200 a partir del 1990",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verificar que los registros devueltos sean de 1990 en adelante\", function () {",
              "    // 1. Convertimos la respuesta de la API a un objeto JSON",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 2. Comprobamos si la respuesta tiene datos en el arreglo \"data\"",
              "    if (jsonData.data && jsonData.data.length > 0) {",
              "        ",
              "        // Recorremos cada elemento devuelto",
              "        jsonData.data.forEach(function(item) {",
              "            // Verificamos que el campo \"year\" sea mayor o igual a 1990",
              "            pm.expect(item.year).to.be.at.least(1990);",
              "        });",
              "        ",
              "    } else if (jsonData.year !== undefined) {",
              "        // (Opcional) Por si en algún momento devuelves un solo objeto directamente",
              "        pm.expect(jsonData.year).to.be.at.least(1990);",
              "    } else {",
              "        // Si no hay datos, el test pasa silenciosamente, ",
              "        // cumpliendo tu regla de \"en caso de que se devuelva algo\"",
              "        console.log(\"La consulta no devolvió datos para evaluar.\");",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
